FROM debian:12-slim

# Debian 12 (GCC 12) only: newer host toolchains (measured GCC 15)
# miscompile the Mupen64Plus-Next core into a ~400x slower binary.
# One image per architecture (linux/amd64 and linux/arm64): each build
# runs natively inside the image of its own arch, so this image carries
# no cross toolchain and no foreign-arch packages.
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
		build-essential \
		cmake \
		ccache \
		git \
		libgl-dev \
		libvulkan-dev \
		nasm \
		python3 \
		scons \
		xz-utils \
		zip \
		zlib1g-dev \
	&& rm -rf /var/lib/apt/lists/*
# Transparent ccache: scons and CMake resolve the compiler to an absolute
# path and SCons rebuilds its child environment, so the /usr/bin driver
# names become scripts that default CCACHE_DIR and invoke ccache with the
# resolved compiler binary; the alternatives symlinks are replaced, the
# real versioned binaries stay put.
RUN for name in cc gcc g++ c++; do \
		real=$(readlink -f /usr/bin/$name) && \
		rm /usr/bin/$name && \
		printf '#!/bin/sh\nexport CCACHE_DIR="${CCACHE_DIR:-/work/.ccache}"\nexec /usr/bin/ccache %s "$@"\n' "$real" > /usr/bin/$name && \
		chmod +x /usr/bin/$name; \
	done
# One directory per architecture image; make clean wipes build/, so the
# cache lives at the worktree root, gitignored.
ENV CCACHE_DIR=/work/.ccache
