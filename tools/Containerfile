FROM debian:12-slim

# Debian 12 (GCC 12) only: newer host toolchains (measured GCC 15)
# miscompile the Mupen64Plus-Next core into a ~400x slower binary.
# One image per architecture (linux/amd64 and linux/arm64): each build
# runs natively inside the image of its own arch, so this image carries
# no cross toolchain and no foreign-arch packages.
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
		build-essential \
		cmake \
		git \
		libgl-dev \
		libvulkan-dev \
		nasm \
		python3 \
		scons \
		xz-utils \
		zip \
		zlib1g-dev \
	&& rm -rf /var/lib/apt/lists/*
