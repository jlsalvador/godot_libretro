FROM debian:12-slim
# Debian 12 (GCC 12) only: artifacts come from this pinned image, not from
# whatever host toolchain is installed (drift changes the binaries), and
# cross-compiling from the host does not work for this stack (godot-cpp's
# SConstruct appends -march=armv8-a for arm64 to the host compiler).
# One image per architecture (linux/amd64 and linux/arm64): each build
# runs natively inside the image of its own arch, so this image carries
# no cross toolchain and no foreign-arch packages.
RUN apt-get update && \
	apt-get install -y --no-install-recommends \
		build-essential \
		ccache \
		git \
		libvulkan-dev \
		pkg-config \
		scons \
		zip \
	&& rm -rf /var/lib/apt/lists/*
# Transparent ccache: scons resolves the compiler to an absolute
# path and SCons rebuilds its child environment, so the /usr/bin driver
# names become scripts that default CCACHE_DIR and HOME (ccache resolves
# the home directory at startup even with CCACHE_DIR set, and the
# container's numeric user has no passwd entry) and invoke ccache with
# the resolved compiler binary; the alternatives symlinks are replaced,
# the real versioned binaries stay put.
RUN for name in cc gcc g++ c++; do \
		real=$(readlink -f /usr/bin/$name) && \
		rm /usr/bin/$name && \
		printf '#!/bin/sh\nexport CCACHE_DIR="${CCACHE_DIR:-/work/.ccache}"\nexport HOME="${HOME:-/root}"\nexec /usr/bin/ccache %s "$@"\n' "$real" > /usr/bin/$name && \
		chmod +x /usr/bin/$name; \
	done
# One directory per architecture image; make clean wipes build/, so the
# cache lives at the worktree root, gitignored.
ENV CCACHE_DIR=/work/.ccache
